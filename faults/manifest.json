      "id": "oracle-black-scholes",
      "kind": "oracle",
      "covers": "Black-Scholes closed form",
      "bug": "The strike leg of the value is discounted at the dividend yield instead of the rate, which no row with r = q can see.",
      "edits": [
        {
          "file": "src/oracle/black_scholes.hpp",
          "find": "g.value = phi * (m.spot * df_q * cdf1 - strike * df_r * cdf2);",
          "replace": "g.value = phi * (m.spot * df_q * cdf1 - strike * df_q * cdf2);"
        }
      ],
      "preset": "release",
      "targets": ["aadp_closed_form_test"],
      "command": ["{build}/bin/aadp_closed_form_test", "--gtest_filter=BlackScholes.*"],
      "detect": "test",
      "reason": "\\[  FAILED  \\] BlackScholes\\.PutCallParity",
      "timeout_s": 120
    },
